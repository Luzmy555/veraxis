# Copia este archivo a .env y completa los valores reales. Nunca subas .env al repositorio.

# Cadena de conexión de tu base de datos PostgreSQL (ej. Neon, Supabase, RDS, etc.)
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Puerto en el que corre el backend
PORT=4000

# Secreto usado para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia de los tokens JWT (ej. 1h, 12h, 7d)
JWT_EXPIRES_IN=12h
